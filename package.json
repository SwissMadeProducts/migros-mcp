{
  "name": "migros-mcp",
  "version": "0.3.1",
  "description": "MCP server for Migros Switzerland: search products, get nutrition info, find stores, and (with credentials) manage your basket and order history",
  "main": "dist/index.js",
  "bin": {
    "migros-mcp": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "start:http": "node dist/http.js",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lewpgs/migros-mcp.git"
  },
  "homepage": "https://github.com/lewpgs/migros-mcp",
  "bugs": {
    "url": "https://github.com/lewpgs/migros-mcp/issues"
  },
  "author": "lewpgs",
  "keywords": [
    "mcp",
    "migros",
    "switzerland",
    "grocery",
    "nutrition",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.21.0",
    "cheerio": "^1.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "railway": "^3.16.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
